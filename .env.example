# Run python scripts/setup.py to create .env with a unique token.
HOLD_LINE_TOKEN=replace-with-a-random-token
POSTGRES_PASSWORD=replace-with-a-random-password

# Optional model wording. No model calls occur in rehearsal.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional tracing; requires its own key only when explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional services for python run.py --worker.
# DATABASE_URL=postgresql://holdline:holdline@127.0.0.1:55432/holdline
# REDIS_URL=redis://127.0.0.1:63791/0
# HOLD_LINE_ASYNC_ENABLED=true
